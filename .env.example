# ============================================================
# Lawyer Case Diary — Environment Variables
# Copy this file to .env and fill in real values.
# Without a .env file, the app throws fatal errors on startup
# (see src/lib/env.ts and src/lib/db.ts).
# ============================================================

# ── Required ────────────────────────────────────────────────

# PostgreSQL connection string (pooled, for runtime queries)
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# Direct (non-pooled) PostgreSQL connection, used by Prisma migrations.
# Falls back to DATABASE_URL if unset — set separately if you're on a
# pooler (e.g. Supabase, Prisma Postgres) that needs a direct URL for
# schema migrations.
DIRECT_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# Secret used to sign/verify JWTs. Generate with: openssl rand -base64 32
JWT_SECRET="replace-with-a-long-random-string"

# Public base URL of the deployed app (no trailing slash)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ── Recommended (app runs without these, with reduced functionality) ──

# Stripe billing
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_ULTIMATE_PRICE_ID=""
STRIPE_PREMIUM_PRICE_ID=""

# Outbound email — Gmail SMTP, round-robin across multiple accounts.
# Format: "email1:app_password1,email2:app_password2"
GMAIL_ACCOUNTS=""
# Or, single-account form (used if GMAIL_ACCOUNTS is unset):
GMAIL_USER=""
GMAIL_APP_PASSWORD=""

# ── Optional ────────────────────────────────────────────────

# External cache-revalidation webhook (see src/lib/optimizer.ts).
# If unset, revalidation calls are silently skipped.
OPTIMIZER_URL=""
OPTIMIZER_KEY=""
